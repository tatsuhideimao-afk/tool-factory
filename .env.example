# ===== 03-generate =====
# 企画→実装コード生成に使う。Phase 1 では手書きツールのみなら不要。
ANTHROPIC_API_KEY=

# ===== 05-deploy (Cloudflare Pages) =====
# Pages プロジェクトへ wrangler pages deploy するためのトークン
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# config/site.json の pagesProject を上書きしたいときだけ設定
CF_PAGES_PROJECT=

# ===== 06-measure (Cloudflare Web Analytics) =====
# GraphQL Analytics API を叩ける権限付きトークン（Deploy 用と分けてよい）
CF_ANALYTICS_API_TOKEN=
# Web Analytics のサイトタグ（ダッシュボードの JS スニペットに載っている値）
CF_WEB_ANALYTICS_SITE_TAG=

# ===== 07-report =====
DISCORD_WEBHOOK_URL=
